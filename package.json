{
  "name": "2048",
  "version": "1.0.0",
  "description": "A desktop 2048 game built with Electron.",
  "main": "main.js",
  "author": "block-0N",
  "license": "MIT",
  "copyright": "Copyright © 2026 block-0N",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/block-0N/2048.git"
  },
  "bugs": {
    "url": "https://github.com/block-0N/2048/issues"
  },
  "homepage": "https://github.com/block-0N/2048#readme",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.block0n.game2048",
    "productName": "2048游戏",
    "copyright": "Copyright © 2026 block-0N",
    "artifactName": "2048-Setup-${version}.${ext}",
    "publish": null,
    "files": [
      "main.js",
      "index.html",
      "2048.css",
      "2048.js",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "2048",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}